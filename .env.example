# SQLite is the judged local database. The path is relative to the repository root.
DATABASE_URL="file:./prisma/dev.db"

# Production only. When DATABASE_URL is absent, Prisma uses hosted libSQL.
# Vercel's Turso integration supplies these automatically.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Generate a unique value for non-demo use: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional. Routes fall back to persisted city coordinates when omitted.
GEOAPIFY_API_KEY=""

# Local development prints password recovery links to the terminal.
# Set to "smtp" to send real emails via SMTP (requires SMTP_* variables below).
EMAIL_PROVIDER="console"

# Required when EMAIL_PROVIDER="smtp". Configure your SMTP server here.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@globetrotter.com"
