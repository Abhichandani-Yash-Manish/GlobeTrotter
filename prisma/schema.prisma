generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  avatar            String?
  role              String             @default("USER")
  language          String             @default("en")
  defaultPrivacy    String             @default("private")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  trips             Trip[]
  savedDestinations SavedDestination[]
  tripMemberships   TripMember[]
  createdInvites    TripInvite[]        @relation("InviteCreator")
  resetTokens       PasswordResetToken[]
  mediaAssets       MediaAsset[]
}

model Trip {
  id          String     @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  budget      Float?
  isPublic    Boolean    @default(false)
  publicId    String?    @unique
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       TripStop[]
  expenses    Expense[]
  members     TripMember[]
  invites     TripInvite[]

  @@index([userId])
  @@index([publicId])
}

model TripStop {
  id         String         @id @default(cuid())
  tripId     String
  cityId     String
  startDate  DateTime
  endDate    DateTime
  order      Int
  notes      String?
  arrivalMode String        @default("train")
  arrivalDurationMinutes Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id])
  activities TripActivity[]
  expenses   Expense[]

  @@index([tripId])
  @@index([cityId])
  @@index([tripId, startDate, endDate])
}

model City {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  country           String
  region            String
  costIndex         Float              @default(3.0)
  popularity        Float              @default(3.0)
  description       String?
  imageUrl          String?
  latitude          Float?
  longitude         Float?
  bestSeason        String?
  idealDays         Int?
  timezone          String?
  currencyCode      String?
  dailyBudget       Float?
  tags              String             @default("[]")
  imageCredit       String?
  imageSourceUrl    String?
  createdAt         DateTime           @default(now())
  stops             TripStop[]
  activities        Activity[]
  savedDestinations SavedDestination[]

  @@unique([name, country])
  @@index([name])
  @@index([country])
  @@index([region])
}

model Activity {
  id            String         @id @default(cuid())
  name          String
  description   String?
  category      String
  cost          Float          @default(0)
  duration      Float          @default(1)
  imageUrl      String?
  address       String?
  latitude      Float?
  longitude     Float?
  websiteUrl    String?
  bookingUrl    String?
  accessibility String?
  tags          String         @default("[]")
  imageCredit   String?
  imageSourceUrl String?
  cityId        String
  createdAt     DateTime       @default(now())
  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripActivities TripActivity[]

  @@index([cityId])
  @@index([category])
}

model TripActivity {
  id         String   @id @default(cuid())
  tripStopId String
  activityId String
  date       DateTime
  startTime  String?
  duration   Float?
  cost       Float?
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tripStop   TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id])

  @@index([tripStopId])
  @@index([activityId])
  @@index([tripStopId, date])
}

model Expense {
  id          String    @id @default(cuid())
  tripId      String
  tripStopId  String?
  category    String
  amount      Float
  description String?
  date        DateTime
  createdAt   DateTime  @default(now())
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripStop    TripStop? @relation(fields: [tripStopId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([category])
  @@index([tripId, date])
}

model SavedDestination {
  id        String   @id @default(cuid())
  userId    String
  cityId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@index([userId])
}

model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

model TripInvite {
  id         String    @id @default(cuid())
  tripId     String
  creatorId  String
  tokenHash  String    @unique
  role       String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator    User      @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  mimeType  String
  bytes     Bytes
  width     Int
  height    Int
  size      Int
  altText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model RouteSegmentCache {
  id              String   @id @default(cuid())
  fromCityId      String
  toCityId        String
  mode            String
  provider        String
  geometry        String
  distanceKm      Float
  durationMinutes Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fromCityId, toCityId, mode, provider])
  @@index([expiresAt])
}
