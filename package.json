{
  "name": "globetrotter-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:prepare": "node scripts/prepare-database.mjs",
    "db:migrate": "npm run db:prepare && prisma migrate deploy",
    "db:migrate:dev": "npm run db:prepare && prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:bootstrap:turso": "tsx scripts/bootstrap-turso.ts",
    "db:reset": "npm run db:prepare && prisma migrate reset --force",
    "reset-demo": "npm run db:reset",
    "verify:demo": "node scripts/verify-demo.mjs",
    "check": "npm run db:generate && npm run lint && npm run test && npm run build && npm run verify:demo",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "nanoid": "^6.0.1",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
